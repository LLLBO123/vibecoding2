<view class="page">
  <view class="section">
    <view class="section-title">
      <text>采购清单</text>
      <view class="title-actions">
        <button class="button-ghost compact" bindtap="manualRefresh">刷新</button>
        <button class="button-ghost compact" bindtap="refreshFromMenu">重算</button>
        <button class="button-primary compact" open-type="share">分享</button>
      </view>
    </view>
    <view wx:if="{{syncStatusText}}" class="sync-status">{{syncStatusText}}</view>
    <view class="muted">按今天确认的菜单自动合并食材。</view>
    <view class="hide-row" bindtap="toggleHideChecked">
      <view class="mini-check {{hideChecked ? 'checked' : ''}}"></view>
      <text>隐藏已买</text>
    </view>
  </view>

  <view wx:if="{{groups.length === 0}}" class="empty">还没有生成清单，先去“菜单”里确认今天做什么。</view>

  <view wx:for="{{groups}}" wx:key="category" class="section">
    <view class="group-title">{{item.category}}</view>
    <view wx:for="{{item.items}}" wx:key="id" class="shopping-item card {{item.checked ? 'checked-item' : ''}}" bindtap="toggleItem" data-id="{{item.id}}">
      <view class="tick {{item.checked ? 'checked' : ''}}"></view>
      <view class="shopping-main">
        <view class="row space-between">
          <view class="ingredient {{item.checked ? 'done' : ''}}">{{item.name}}</view>
          <view class="amount">{{item.amountsText}}</view>
        </view>
        <view class="muted">来自：{{item.dishesText}}</view>
      </view>
    </view>
  </view>
</view>
