.compact {
  min-width: 120rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.title-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.sync-status {
  margin: -6rpx 0 14rpx;
  color: #2f6f5e;
  font-size: 24rpx;
  text-align: right;
}

.status-card {
  margin-bottom: 20rpx;
  border-left: 8rpx solid #c7a15a;
  background: #fffaf1;
}

.status-card.voting {
  border-left-color: #2f6f5e;
  background: #f6fbf4;
}

.status-card.deadline {
  border-left-color: #b05b45;
  background: #fff6f1;
}

.status-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.selected-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.selected-pill {
  display: inline-flex;
  align-items: center;
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #2f6f5e;
  color: #ffffff;
  font-size: 26rpx;
  box-shadow: 0 6rpx 14rpx rgba(47, 111, 94, 0.14);
}

.random-panel {
  margin-bottom: 28rpx;
}

.random-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.random-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.people-step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #e3d7c8;
  border-radius: 12rpx;
  background: #fffaf1;
  color: #52483e;
  font-size: 34rpx;
  font-weight: 700;
}

.people-input {
  width: 86rpx;
  height: 64rpx;
  border: 1rpx solid #ded2c3;
  border-radius: 12rpx;
  background: #fffefa;
  color: #2f2a25;
  font-size: 30rpx;
  text-align: center;
}

.people-label {
  color: #6d5b49;
  font-size: 26rpx;
}

.random-button {
  flex: 1;
  height: 64rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.menu-card {
  margin-bottom: 18rpx;
}

.menu-card.selected {
  border-color: #94b89e;
  background: #f7fcf4;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 700;
}

.check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #f3ece1;
  color: #6d5b49;
  font-size: 24rpx;
}

.check.checked {
  background: #2f6f5e;
  color: #ffffff;
}
