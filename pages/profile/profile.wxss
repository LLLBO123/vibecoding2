.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.member-card.active-card {
  border-color: #94b89e;
  background: #f7fcf4;
}

.member-name {
  font-size: 34rpx;
  font-weight: 700;
}

.current {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #fffaf1;
  color: #6d5b49;
  font-size: 24rpx;
}

.current.active {
  background: #2f6f5e;
  color: #ffffff;
}

.guide {
  margin-top: 34rpx;
  background: #fffaf1;
}

.guide-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.guide-line {
  margin-top: 10rpx;
  color: #5f554c;
  font-size: 26rpx;
}

.reset-button {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 12rpx;
}
